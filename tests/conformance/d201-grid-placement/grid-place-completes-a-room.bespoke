# A mark a grid places needs no room-block line, and walks to its cell like any mark.
# pins: D-201
# ticks: 12
# expect fact: Arrived(Hero)

scene Yard:
  cast: Hero
  marks: Gate, Well

room Yard:
  mark Gate at 40 120

grid Floor in Yard:
  size 4 4
  cell 10
  origin -10 -20
  place Well 2 2

relation Arrived(who)

when Hero arrives at Well:
  remember Arrived(Hero)

routine Stroll(Hero):
  walk Hero to Well
