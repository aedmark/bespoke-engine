scene: Long Gallery
cast: Audra
props: VelvetRope
marks: Window, Bench

scene: Locked Studio
cast: Corin, Pell
props: EaselBoard
marks: Easel, Corner

relation Hides(who)
relation Found(who)

remember Hides(Pell)

agenda FindPell:
  actor Corin
  target Pell
  once
  requires Hides(Pell)

on cue Intercepts(Corin, Pell, FindPell):
  say Corin: "Caught you at the easel."
  remember Found(Pell)
  forget Hides(Pell)