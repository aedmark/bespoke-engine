# The Lamplighter's Round (P46-05): an original proof drawn entirely from the PNG files beside
# this script. The build compiles it with `bespoke compile`, which reads the PNGs; the desktop
# proof, its headless run, and its browser page all load that package. The art and the talk
# live in `art.bespoke` and `talk.bespoke`, included where they belong (P48-15, D-169).
#
# Dusk: Nell Brindle, lamplighter, is late. Hobb the chandler gives her a taper and the run of
# his oil cask; one fill of her can lights one lamp. The lane lamp lights, but a jackdaw, Mrs
# Jessop, has nested in the market lamp, and only something shinier than Constable Pike's
# buttons will shift her. Hobb parts with a brass thimble. Nightfall: both lamps burn, Pike walks
# his round, and Nell has the last word.

scene: Tallow Lane
cast: Nell, Hobb
props: OilCask, LaneLamp, ShopWindow, ShopDoor, Archway
marks: Stoop, Doorstep, LanePost, LaneEnd
backdrop: TallowLane

scene: Market Steps
cast: Pike
props: StepsLamp, Fountain, MarketHall
marks: StepsFoot, FountainSide, StepsPost
backdrop: MarketSteps

include "art.bespoke"

relation Carries(holder, item)
relation CanFull(who)
relation Lit(lamp)
relation Nesting(bird, lamp)
relation Heard(who, tale)
relation RoundDone(who)
entity OilCan, Taper, Thimble, Jackdaw, JessopTale

remember Nesting(Jackdaw, StepsLamp)
remember Looks(StepsLamp, LampNest)
remember Carries(Nell, OilCan)

# The beginning: Hobb sees the clock before Nell does.
routine Dusk(Hobb):
  wait 1 ticks
  say Hobb: "Nell Brindle! The clock's struck six and not a lamp lit. Pike walks his round at dark."
  wait 2 ticks
  say Nell: "Taper, oil, lamps. I know, Hobb. I know."

include "talk.bespoke"

on cue Uses(Nell, OilCask):
  if not Carries(Nell, Taper):
    say Hobb: "Oi! Ask before you help yourself to my oil, Nell Brindle."
  if Carries(Nell, Taper):
    if CanFull(Nell):
      say Nell: "The can is full already."
    if not CanFull(Nell):
      remember CanFull(Nell)
      say Nell: "Filled to the brim."

on cue Uses(Nell, LaneLamp):
  if Lit(LaneLamp):
    say Nell: "That one is burning."
  if not Lit(LaneLamp):
    if not Carries(Nell, Taper):
      say Nell: "No flame and no oil. Hobb will have a taper."
    if Carries(Nell, Taper):
      if not CanFull(Nell):
        say Nell: "Dry. The can needs filling at the cask."
      if CanFull(Nell):
        remember Lit(LaneLamp)
        remember Looks(LaneLamp, LampLit)
        forget CanFull(Nell)
        say Nell: "Oil, wick, flame. Tallow Lane is lit, and my can is empty."

on cue Uses(Nell, StepsLamp):
  if Lit(StepsLamp):
    say Nell: "That one is burning."
  if not Lit(StepsLamp):
    if not Nesting(Jackdaw, StepsLamp):
      if not Carries(Nell, Taper):
        say Nell: "No flame and no oil. Hobb will have a taper."
      if Carries(Nell, Taper):
        if not CanFull(Nell):
          say Nell: "Dry. Back to the cask on Tallow Lane."
        if CanFull(Nell):
          remember Lit(StepsLamp)
          remember Looks(StepsLamp, LampLit)
          forget CanFull(Nell)
          say Nell: "And the market steps, with the last of my oil. That's the round."
    if Nesting(Jackdaw, StepsLamp):
      if not Carries(Nell, Thimble):
        say Nell: "Mrs Jessop glares at me from the lamp. I can't light a lamp with a bird in it."
      if Carries(Nell, Thimble):
        forget Carries(Nell, Thimble)
        forget Nesting(Jackdaw, StepsLamp)
        remember Looks(StepsLamp, LampDark)
        say Nell: "A brass thimble for your trouble, Mrs Jessop. She snatches it and is gone over the rooftops."

# The end: both lamps burn before dark.
when Lit(LaneLamp) and Lit(StepsLamp):
  remember RoundDone(Nell)
  say Pike: "Both lamps lit before dark, and Mrs Jessop rehoused. Good night, Nell Brindle."
  walk Pike to StepsPost
  wait 3 ticks
  say Nell: "Round done. Tomorrow I'm buying my own thimble."
