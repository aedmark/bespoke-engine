{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/3x-documentation-scheme/manual.schema.json",
  "title": "3x Documentation Manual",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "manual", "sections"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]},
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "short_name": {"type": "string"},
        "version": {"type": ["string", "number"]},
        "repository": {"type": "string"}
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "description": {"type": "string"},
        "badges": {"type": "array", "items": {"type": "string"}},
        "footer": {"type": "string"},
        "reviewed": {"$ref": "#/$defs/reviewed"}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "accent_secondary": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "icon": {"type": "string"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "why_basis": {
      "type": "string",
      "enum": ["recorded", "observed", "inferred", "external"]
    },
    "evidence_kind": {
      "type": "string",
      "enum": ["source", "test", "decision", "spec", "url", "command", "document"]
    },
    "reviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "commit"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
        "by": {"type": "string"},
        "interval_days": {"type": "integer", "minimum": 1}
      }
    },
    "dimension": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": {"type": "string", "minLength": 1},
            "points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "anyOf": [{"required": ["lead"]}, {"required": ["points"]}]
        }
      ]
    },
    "evidence": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "target"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "kind": {"$ref": "#/$defs/evidence_kind"}
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "what", "how", "why", "why_basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "synopsis": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "what": {"$ref": "#/$defs/dimension"},
        "how": {"$ref": "#/$defs/dimension"},
        "why": {"$ref": "#/$defs/dimension"},
        "why_basis": {"$ref": "#/$defs/why_basis"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "related": {"type": "array", "items": {"type": "string"}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entries"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
      }
    }
  }
}
