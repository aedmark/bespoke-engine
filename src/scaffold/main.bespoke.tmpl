# {{name}}: a BeSpoke starter game.
# Edit this file, then run: zig build run
# Headless, for a fixed tick count: zig build run -- --headless --ticks 80

scene Lighthouse:
  cast: Hero, Keeper
  props: Lamp, Logbook
  marks: Door, Stair, Gallery

relation Investigated(who, place)
relation Warned(who)
relation LampLit(lamp)

score Tide:
  lead "t88 o5 l8 @1 e g a g e4 d4 L c4 e4 g2 e4 d4 c2"
  bass "o3 l4 @0 c g a e L f c g c"
  chords "o4 l2 v8 @7 e d L f e"
  scene Lighthouse

score Storm: "t150 o5 l16 @5 L [c d e d]2 [e f g f]2"

agenda WarnOff:
  actor Keeper
  target Hero
  priority 3
  cooldown 60
  requires Investigated(Hero, Gallery)
  unless Warned(Hero)

transition to scene Lighthouse

routine Explore(Hero):
  walk Hero to Stair
  wait 4 ticks
  walk Hero to Gallery
  remember Investigated(Hero, Gallery)
  wait 20 ticks
  remember LampLit(Lamp) for 30 ticks

routine Tend(Keeper):
  loop:
    walk Keeper to Door
    wait 10 ticks
    walk Keeper to Stair
    wait 10 ticks

on cue Intercepts(Keeper, Hero, WarnOff):
  remember Warned(Hero)
  say Keeper: "The gallery is no place for visitors."
  choice "I only wanted to see the lamp.":
    say Keeper: "Then look from the door."
  choice "Who lit it last night?":
    say Keeper: "Nobody you would believe."

when LampLit(Lamp):
  play score Storm

when Lamp forgets LampLit:
  stop score
