# {{name}}: build and test on Linux and macOS, and build the browser version. Windows is not
# a supported target until a Windows contributor maintains it (D-143).
# The engine is fetched beside the game and build.zig.zon is pointed at it, because the
# local `.path` in build.zig.zon names a checkout that exists only on your machine.
# Change BESPOKE_ENGINE_REF when the game is ready to use a different engine release.
name: build

on:
  push:
  pull_request:

env:
  BESPOKE_ENGINE_REPO: aedmark/bespoke-engine
  BESPOKE_ENGINE_REF: refs/tags/v1.2.0
  ZIG_VERSION: 0.17.1

defaults:
  run:
    shell: bash

jobs:
  native:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
        with:
          path: game
      - uses: actions/checkout@v4
        with:
          repository: ${{ env.BESPOKE_ENGINE_REPO }}
          ref: ${{ env.BESPOKE_ENGINE_REF }}
          path: bespoke-engine
      # Zig comes straight from ziglang.org, checked against the published SHA-256, as the
      # engine's own CI does; the community setup action could not fetch 0.17.1.
      - name: Install Zig
        run: |
          case "$RUNNER_OS-$RUNNER_ARCH" in
            Linux-X64) asset="zig-x86_64-linux-$ZIG_VERSION.tar.xz"; sum=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a ;;
            macOS-ARM64) asset="zig-aarch64-macos-$ZIG_VERSION.tar.xz"; sum=75f1bc7a1e9852f17ec9a0c1895f767c4ec56d46bc8a834920eece1d0359dd8d ;;
            macOS-X64) asset="zig-x86_64-macos-$ZIG_VERSION.tar.xz"; sum=9af07b20319fbd0c92ee46ad23e81d6a782b1aaea2cfb8dcbff35f1d2c7ddbb7 ;;
            *) echo "No Zig $ZIG_VERSION download for $RUNNER_OS-$RUNNER_ARCH"; exit 1 ;;
          esac
          tmp="$RUNNER_TEMP"
          curl --fail --location --retry 3 --output "$tmp/$asset" "https://ziglang.org/download/$ZIG_VERSION/$asset"
          if command -v sha256sum >/dev/null; then got="$(sha256sum "$tmp/$asset" | cut -d' ' -f1)"; else got="$(shasum -a 256 "$tmp/$asset" | cut -d' ' -f1)"; fi
          if [ "$got" != "$sum" ]; then echo "Checksum mismatch for $asset: $got"; exit 1; fi
          mkdir -p "$tmp/zig"
          tar -xJf "$tmp/$asset" --strip-components=1 -C "$tmp/zig"
          echo "$tmp/zig" >> "$GITHUB_PATH"
      - name: Point the game at the fetched engine
        run: perl -pi -e 's|\.path = ".*"|.path = "../bespoke-engine"|' game/build.zig.zon
      - name: Install SDL2 (Linux)
        if: runner.os == 'Linux'
        run: sudo apt-get update && sudo apt-get install -y libsdl2-dev
      - name: Install SDL2 (macOS)
        if: runner.os == 'macOS'
        run: brew install sdl2
      - name: Test
        working-directory: game
        run: zig build test
      - name: Build the bundled release
        working-directory: game
        run: zig build -Dbundle -Doptimize=ReleaseSafe
      - name: Run it headless
        working-directory: game
        run: |
          cd zig-out/bin
          ./{{name}} --headless --ticks 40 --quiet < /dev/null
      - uses: actions/upload-artifact@v4
        with:
          name: {{name}}-${{ runner.os }}
          path: game/zig-out/bin/

  web:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          path: game
      - uses: actions/checkout@v4
        with:
          repository: ${{ env.BESPOKE_ENGINE_REPO }}
          ref: ${{ env.BESPOKE_ENGINE_REF }}
          path: bespoke-engine
      # Zig comes straight from ziglang.org, checked against the published SHA-256, as the
      # engine's own CI does; the community setup action could not fetch 0.17.1.
      - name: Install Zig
        run: |
          case "$RUNNER_OS-$RUNNER_ARCH" in
            Linux-X64) asset="zig-x86_64-linux-$ZIG_VERSION.tar.xz"; sum=3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a ;;
            macOS-ARM64) asset="zig-aarch64-macos-$ZIG_VERSION.tar.xz"; sum=75f1bc7a1e9852f17ec9a0c1895f767c4ec56d46bc8a834920eece1d0359dd8d ;;
            macOS-X64) asset="zig-x86_64-macos-$ZIG_VERSION.tar.xz"; sum=9af07b20319fbd0c92ee46ad23e81d6a782b1aaea2cfb8dcbff35f1d2c7ddbb7 ;;
            *) echo "No Zig $ZIG_VERSION download for $RUNNER_OS-$RUNNER_ARCH"; exit 1 ;;
          esac
          tmp="$RUNNER_TEMP"
          curl --fail --location --retry 3 --output "$tmp/$asset" "https://ziglang.org/download/$ZIG_VERSION/$asset"
          if command -v sha256sum >/dev/null; then got="$(sha256sum "$tmp/$asset" | cut -d' ' -f1)"; else got="$(shasum -a 256 "$tmp/$asset" | cut -d' ' -f1)"; fi
          if [ "$got" != "$sum" ]; then echo "Checksum mismatch for $asset: $got"; exit 1; fi
          mkdir -p "$tmp/zig"
          tar -xJf "$tmp/$asset" --strip-components=1 -C "$tmp/zig"
          echo "$tmp/zig" >> "$GITHUB_PATH"
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Point the game at the fetched engine
        run: perl -pi -e 's|\.path = ".*"|.path = "../bespoke-engine"|' game/build.zig.zon
      # The browser build compiles the script with the engine's native tool, which links SDL2.
      - name: Install SDL2
        run: sudo apt-get update && sudo apt-get install -y libsdl2-dev
      - name: Build and smoke-test the browser version
        working-directory: game
        run: |
          zig build web
          node web/smoke.js
      - uses: actions/upload-artifact@v4
        with:
          name: {{name}}-web
          path: game/zig-out/web/
