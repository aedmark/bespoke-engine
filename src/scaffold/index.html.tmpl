<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{name}}</title>
<style>
  body { margin: 0; background: #12161d; color: #c8d0dc; font: 14px system-ui, sans-serif; display: flex; flex-direction: column; align-items: center; }
  canvas { margin-top: 16px; width: min(96vw, 1280px); image-rendering: pixelated; border: 1px solid #2c3442; }
  p { max-width: 640px; text-align: center; }
</style>
</head>
<body>
<canvas id="stage" width="1280" height="720"></canvas>
<p><button id="sound" type="button">Sound: off</button></p>
<p>Click a mark to walk. Right-click changes the verb. Space pauses, N steps, R rewinds, and the number keys answer a dialogue. I opens the state inspector: arrows select, Enter centres, Backspace goes back, Home resets, F filters.</p>
<script>
// Loads {{name}}.wasm (the engine's browser runtime with the game's compiled script) and drives it:
// 20 ticks a second, pointer and key events in, the RGBA framebuffer out. Serve this folder
// over HTTP; browsers refuse to fetch a module from a file:// page.
const TICK_MS = 50;
const canvas = document.getElementById('stage');
const ctx = canvas.getContext('2d');
const toCanvas = (e) => {
  const r = canvas.getBoundingClientRect();
  return [Math.round((e.clientX - r.left) * canvas.width / r.width), Math.round((e.clientY - r.top) * canvas.height / r.height)];
};
WebAssembly.instantiateStreaming(fetch('{{name}}.wasm'), {}).then(({ instance }) => {
  const w = instance.exports;
  w.wasm_init(0);
  const draw = () => {
    w.wasm_render_frame();
    const px = new Uint8ClampedArray(w.memory.buffer, w.wasm_framebuffer_ptr(), w.wasm_framebuffer_len());
    ctx.putImageData(new ImageData(new Uint8ClampedArray(px), canvas.width, canvas.height), 0, 0);
  };
  canvas.addEventListener('mousedown', (e) => { if (e.button === 0) { w.wasm_on_pointer_down(...toCanvas(e)); draw(); } });
  canvas.addEventListener('mousemove', (e) => w.wasm_on_pointer_move(...toCanvas(e)));
  canvas.addEventListener('contextmenu', (e) => { e.preventDefault(); w.wasm_on_right_click(...toCanvas(e)); draw(); });
  // Named keys reach the state inspector as their DOM keyCodes; other keys as characters.
  const NAMED = { ArrowLeft: 37, ArrowRight: 39, Enter: 13, Backspace: 8, Home: 36 };
  window.addEventListener('keydown', (e) => {
    const code = NAMED[e.key] || (e.key.length === 1 ? e.key.charCodeAt(0) : 0);
    if (!code) return;
    e.preventDefault();
    w.wasm_on_key_down(code);
    draw();
  });
  // The engine's own synthesizer: the module renders stereo samples on this thread and an
  // AudioWorklet plays them, kept a fifth of a second ahead. The worklet loads from a data: URL,
  // so this page needs no extra file. Browsers start audio only after a click, hence the button.
  const PLAYER = `class P extends AudioWorkletProcessor {
    constructor() { super(); this.q = []; this.o = 0; this.port.onmessage = (e) => this.q.push(e.data); }
    process(_, outs) {
      const l = outs[0][0], r = outs[0][1] || l; let i = 0;
      while (i < l.length) {
        const c = this.q[0]; if (!c) { l.fill(0, i); r.fill(0, i); break; }
        const n = Math.min(l.length - i, c.l.length - this.o);
        l.set(c.l.subarray(this.o, this.o + n), i); r.set(c.r.subarray(this.o, this.o + n), i);
        i += n; this.o += n; if (this.o >= c.l.length) { this.q.shift(); this.o = 0; }
      }
      return true;
    }
  }
  registerProcessor('bespoke-engine', P);`;
  let audio = null;
  let pump = null;
  document.getElementById('sound').addEventListener('click', async (e) => {
    if (audio) {
      clearInterval(pump);
      audio.close();
      audio = null;
      e.target.textContent = 'Sound: off';
      return;
    }
    audio = new AudioContext({ sampleRate: w.wasm_audio_sample_rate() });
    // A data: URL loads from file:// too, where a Blob URL's opaque origin is refused.
    await audio.audioWorklet.addModule('data:text/javascript;charset=utf-8,' + encodeURIComponent(PLAYER));
    const node = new AudioWorkletNode(audio, 'bespoke-engine', { numberOfInputs: 0, outputChannelCount: [2] });
    node.connect(audio.destination);
    const start = audio.currentTime;
    let queued = 0;
    pump = setInterval(() => {
      const played = (audio.currentTime - start) * audio.sampleRate;
      if (queued < played) queued = played;
      while (queued - played < 0.2 * audio.sampleRate) {
        const pcm = new Int16Array(w.memory.buffer, w.wasm_audio_render(1024), 2048);
        const l = new Float32Array(1024), r = new Float32Array(1024);
        for (let i = 0; i < 1024; i++) { l[i] = pcm[2 * i] / 32768; r[i] = pcm[2 * i + 1] / 32768; }
        node.port.postMessage({ l, r }, [l.buffer, r.buffer]);
        queued += 1024;
      }
    }, 25);
    e.target.textContent = 'Sound: on';
  });
  setInterval(() => { w.wasm_step_tick(); draw(); }, TICK_MS);
  draw();
});
</script>
</body>
</html>
