.{
    .name = "{{name}}",
    .version = "0.1.0",
    .dependencies = .{
        // The BeSpoke engine checkout this project was created from. Point it elsewhere, or
        // replace it with a `.url` and `.hash`, to build against another engine.
        .bespoke = .{
            .path = "{{engine_root}}",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "scripts",
        "README.md",
    },
}
