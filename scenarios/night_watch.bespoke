# BeSpoke Narrative Scenario: The Night Watch (P28-03, D-062)
# Script music with scene defaults, an alarm override, and a return to the scene music.
# Whole-line comments avoid language keywords: the lexer tokenizes their text (see HANDOFF).

scene Gatehouse:
  cast: Warden
  marks: Gate, Stair

scene Rampart:
  marks: Tower

relation Alarm(watch)

score Calm:
  lead "t96 o5 l8 @1 e g a g e4 d4 L c4 e4 g2"
  bass "o3 l4 @0 c g a e L f c g c"
  chords "o4 l2 v8 @7 e d L f e"
  drums "l8 v10 k h h h L k h s h"
  scene Gatehouse

score Wind:
  lead "t72 o4 l4 @4 v9 L e2 d2 c1"
  chords "o3 l1 v6 @7 L c < a"
  scene Rampart

score Chase: "t160 o5 l16 @5 L [c d e d]2 [e f g f]2"

transition to scene Gatehouse

routine Watch(Warden):
  wait 10 ticks
  remember Alarm(Warden) for 15 ticks
  wait 20 ticks
  transition to scene Rampart
  wait 10 ticks
  transition to scene Gatehouse

when Alarm(watch):
  play score Chase

when Warden forgets Alarm:
  stop score
